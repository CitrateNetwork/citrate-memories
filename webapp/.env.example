# Memrizz — environment contract (auth seam + gateway). Copy to .env.local.
# NEVER commit real secrets. Only NEXT_PUBLIC_* reaches the browser; everything
# else is server-only and MUST be set in production (fail closed — planset §3.B).

# --- Auth mode -------------------------------------------------------------
# Unset/unknown → oidc (fail closed). Use "mock" ONLY in local dev.
# "mock" in production is disabled unless ALLOW_MOCK_AUTH=1 (a staging opt-in).
NEXT_PUBLIC_AUTH_MODE=mock
# ALLOW_MOCK_AUTH=1

# --- OIDC (server-side verification; required in oidc mode) ----------------
# Both OIDC_ISSUER and OIDC_AUDIENCE must be set or every token is rejected.
OIDC_ISSUER=https://auth.citrate.ai
OIDC_AUDIENCE=memrizz
OIDC_JWKS_URL=https://auth.citrate.ai/jwks
# Optional claim-name overrides (defaults: sub / wallet_address)
# AUTH_CLAIM_SUB=sub
# AUTH_CLAIM_WALLET=wallet_address

# --- OIDC (client-side, public) -------------------------------------------
NEXT_PUBLIC_OIDC_ISSUER=https://auth.citrate.ai
NEXT_PUBLIC_OIDC_CLIENT_ID=memrizz
NEXT_PUBLIC_OIDC_SCOPE=openid profile wallet
# Endpoints are discovered from /.well-known/openid-configuration; override only
# if discovery is unreachable (panva authorize is /auth, not /authorize).
# NEXT_PUBLIC_OIDC_AUTHORIZE_URL=
# NEXT_PUBLIC_OIDC_TOKEN_URL=

# --- mem-gateway (the backend seam) ---------------------------------------
# Server-only origin the BFF calls. The browser talks to the BFF ('self'); set
# the public origin only if a deploy lets the browser reach SSE directly (CSP).
MEM_GATEWAY_ORIGIN=http://127.0.0.1:8787
# NEXT_PUBLIC_MEM_GATEWAY_ORIGIN=

# --- Optional Privy backend (only if NEXT_PUBLIC_AUTH_MODE=privy) ----------
# NEXT_PUBLIC_PRIVY_APP_ID=
# PRIVY_APP_SECRET=

# --- Database (Neon Postgres) — conversation persistence -------------------
# Server-only. Drives owner-scoped persistence (conversations, app state). Unset
# → persistence routes 503 (fail closed). After setting: `pnpm db:migrate`.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/db?sslmode=require

# --- Rate limiting (Upstash REST; in-memory fallback in dev) ---------------
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# --- BYOM connect token signing (gap G-7) ----------------------------------
# Shared HS256 secret between this app (mints) and mem-gateway (verifies). Unset
# → BYOM connect returns 503. Set the SAME value on the gateway.
# MEM_CONNECT_SECRET=
# Public MCP endpoint base shown on the Connect page (gateway origin + /mcp).
# NEXT_PUBLIC_MEM_MCP_ENDPOINT=https://mem-gateway.citrate.ai/mcp

# --- Ask synthesis (LLM) — OpenAI-compatible, self-hosted ------------------
# Points at the DGX llama-server (/v1) via citrate-inference-gateway behind the
# Digital Ocean Caddy front. Unset → Ask stays retrieval-grounded (no synthesis).
# MEMRIZZ_INFERENCE_URL=https://infer.citrate.ai/v1
# MEMRIZZ_INFERENCE_API_KEY=cgk_...
# MEMRIZZ_MODEL=gemma-3-...-it-Q4_K_M
# MEMRIZZ_MAX_OUTPUT_TOKENS=512
