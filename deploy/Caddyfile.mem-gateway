# mem-gateway reverse-proxy — TEMPLATE (fill the placeholders for your deployment)
#
# Append this block to your edge host's Caddyfile, then:
#   caddy validate --config /etc/caddy/Caddyfile && systemctl reload caddy
#
# Pattern: Caddy owns public TLS on an edge/CDN host and reverse-proxies to the
# mem-gateway service running on a backend host (co-located with the RocksDB
# store + embedder). If the backend is reachable only over a private network
# (e.g. Tailscale/WireGuard), point reverse_proxy at its private address.
#
# Placeholders:
#   <PUBLIC_HOSTNAME>   e.g. mem-gateway.example.com
#   <BACKEND_ADDR>      backend host:port, e.g. 10.0.0.5:8799 or a private-net IP
#
# NO CORS: the webapp/BFF reaches this server-to-server, never browser -> gateway.
# Do not add Access-Control-Allow-Origin.

https://<PUBLIC_HOSTNAME> {
	encode gzip

	# Caddy-handled liveness (the app also serves GET /api/health).
	@health path /healthz
	respond @health "ok" 200

	reverse_proxy <BACKEND_ADDR> {
		# CRITICAL: forward the bearer — the gateway independently verifies
		# the user's id_token (iss+aud+exp, RS256). Caddy forwards by default;
		# explicit so a future edit can't silently strip it.
		header_up Authorization {http.request.header.Authorization}
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-Proto https

		transport http {
			# The /api/orgs/:org/layout endpoint can be heavy on first build
			# (PCA over the embeddings), then it's cached.
			read_timeout 300s
			write_timeout 300s
			dial_timeout 5s
			keepalive 5m
		}
	}
}
